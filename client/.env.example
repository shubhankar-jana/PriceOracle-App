# Client Environment Variables (for local Vite and Netlify)
# For local dev:
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# For production on Netlify, set in Netlify dashboard:
# VITE_API_URL=https://<your-server-render-url>.onrender.com/api
# VITE_SOCKET_URL=https://<your-server-render-url>.onrender.com
# VITE_GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
