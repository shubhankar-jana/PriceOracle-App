# Copy this file to .env and fill in real values (never commit .env!)

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# JWT secrets — use long random strings in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_EXPIRE=1d
JWT_REFRESH_EXPIRE=7d

# ML API — set to your Render ML service URL in production
ML_API_URL=https://priceoracle-ml.onrender.com

# Frontend URL — set to your Netlify URL in production (no trailing slash)
CLIENT_URL=https://your-app.netlify.app

# Web Push VAPID keys (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@priceoracle.com

# Optional: External API keys for ML data collection
NEWSAPI_KEY=
FRED_API_KEY=
